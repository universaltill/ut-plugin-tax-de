{
  "id": "com.universaltill.tax-de",
  "name": "Germany Fiscal Compliance (TSE + DSFinV-K)",
  "version": "0.3.2",
  "description": "Starting-point integration against fiskaly's Cloud-TSE (SIGN DE) API for KassenSichV transaction signing, fiskaly's DSFinV-K export API for tax-audit exports, and a DATEV EXTF Buchungsstapel export for handing sales to an accountant. SIGN DE's fiskaly API contract (host, auth, TSS/transaction lifecycle, receipt schema) was verified 2026-08-18 against a real fiskaly sandbox; DSFinV-K export and legal DSFinV-K compliance are NOT verified, chart-of-accounts mapping for the DATEV export is merchant/accountant-configured (no defaults assumed), and none of this is a substitute for tax-advisor sign-off before any merchant relies on it. See README before installing.",
  "author": "Universal Till",
  "website": "https://universaltill.com",
  "canonical_type": "tax",
  "runtime": "wasm",
  "device_arch": "any",
  "min_pos_version": "1.0.0",
  "countries": ["DE"],
  "permissions": [
    "events:receive",
    "sales:read",
    "net:kassensichv-middleware.fiskaly.com",
    "storage"
  ],
  "locales": [
    "en-US",
    "de-DE"
  ],
  "entries": [
    {
      "type": "tax",
      "key": "tse-sign-de",
      "label": "TSE Signing (fiskaly Cloud-TSE)",
      "sort_order": 5
    },
    {
      "type": "export",
      "key": "dsfinvk-export-de",
      "label": "DSFinV-K Export (fiskaly)",
      "sort_order": 10
    },
    {
      "type": "export",
      "key": "datev-buchungsstapel-export-de",
      "label": "DATEV Buchungsstapel Export (EXTF)",
      "sort_order": 15
    }
  ],
  "settings": [
    {
      "key": "fiskaly_api_key",
      "default_value": "",
      "scope": "global"
    },
    {
      "key": "fiskaly_api_secret",
      "default_value": "",
      "scope": "global"
    },
    {
      "key": "fiskaly_tss_id",
      "default_value": "",
      "scope": "global"
    },
    {
      "key": "fiskaly_client_id",
      "default_value": "",
      "scope": "register"
    },
    {
      "key": "fiskaly_cash_register_id",
      "default_value": "",
      "scope": "global"
    },
    {
      "key": "dsfinvk_export_format",
      "default_value": "zip",
      "scope": "global"
    },
    {
      "key": "takeaway_rate_overrides",
      "default_value": "{}",
      "scope": "global"
    },
    {
      "key": "datev_berater_nr",
      "default_value": "",
      "scope": "global"
    },
    {
      "key": "datev_mandant_nr",
      "default_value": "",
      "scope": "global"
    },
    {
      "key": "datev_sachkontenlaenge",
      "default_value": "4",
      "scope": "global"
    },
    {
      "key": "datev_wj_beginn",
      "default_value": "0101",
      "scope": "global"
    },
    {
      "key": "datev_konto_kasse",
      "default_value": "",
      "scope": "global"
    },
    {
      "key": "datev_erloeskonten",
      "default_value": "{}",
      "scope": "global"
    },
    {
      "key": "datev_bu_schluessel",
      "default_value": "{}",
      "scope": "global"
    }
  ],
  "entrypoint": "./bin/plugin.wasm",
  "hooks": [
    {
      "event": "sale.completed",
      "action": "tse.sign"
    },
    {
      "event": "tax.rate.ask",
      "action": "tax.rate"
    },
    {
      "event": "export.requested.ask",
      "action": "export.dsfinvk"
    }
  ]
}
